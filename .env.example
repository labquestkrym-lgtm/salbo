# ---------------------------------------------------------------------------
# Example environment file. Copy to `.env` and fill in. NEVER commit `.env`.
# Only SECRETS and environment selection belong here. Strategy/risk parameters
# live in configs/*.yaml (validated by Pydantic Settings).
# ---------------------------------------------------------------------------

# App mode: backtest | paper | sandbox | live
APP_MODE=backtest
APP_ENVIRONMENT=development

# --- Live trading gates (all required to ever reach live; see ADR-0003) ------
# Keep DISABLED. Live also requires validated risk config + reconciliation +
# health check + the confirmation code echoed to POST /strategy/start.
LIVE_TRADING_ENABLED=false
# One-time confirmation code required to start the strategy in live mode.
LIVE_CONFIRMATION_CODE=

# --- Database ---------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tradingbot
POSTGRES_USER=tradingbot
POSTGRES_PASSWORD=change-me-local-only

# --- Redis (optional) -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Control API auth -------------------------------------------------------
# Bearer token required by the FastAPI control plane for dangerous operations.
API_AUTH_TOKEN=change-me-local-only

# --- Broker credentials (leave blank until paper/sandbox is validated) ------
BROKER_NAME=mock
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCOUNT_ID=
# Must be a sandbox/test endpoint in development & test.
BROKER_ENDPOINT=

# --- Notifications (optional) ----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
